# Copier ce fichier en .env puis remplir. Ne jamais committer .env.

# Jenkins
JENKINS_ADMIN_PASSWORD=change-moi
GIT_REPO_URL=https://github.com/VOTRE_COMPTE/m354-devops-demo.git

# Docker Hub (Release). Laisser vide pour garder l'image en local.
DOCKER_IMAGE=VOTRE_COMPTE_DOCKERHUB/m354-planning
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# Trello (Plan). Laisser vide pour faire la démo sans Trello.
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_LIST_TODO=
TRELLO_LIST_DONE=

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
